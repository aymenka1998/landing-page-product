NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
ADMIN_EMAIL=admin@example.com
# Google Apps Script web app URL and a private random token also stored in Apps Script Properties
GOOGLE_SHEET_WEBHOOK=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_SHEET_ACCESS_TOKEN=replace-with-a-long-random-secret
GEMINI_API_KEY=your-google-ai-studio-api-key
# Optional; defaults to gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional; used automatically if the primary model returns HTTP 503
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
